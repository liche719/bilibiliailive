# Local infrastructure
SERVER_ADDRESS=127.0.0.1
POSTGRES_DB=ai_live
POSTGRES_USER=ai_live
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

# Short-term viewer memory
AI_MEMORY_MAX_MESSAGES=8
AI_MEMORY_MAX_ACTIVE_MEMORIES=1000
AI_MEMORY_TTL=PT30M
AI_MEMORY_REDIS_KEY_PREFIX=ai-live:chat-memory

# Recent public room conversation shared across viewers
AI_ROOM_CONTEXT_MAX_ENTRIES=12
AI_ROOM_CONTEXT_TTL=PT30M
AI_ROOM_CONTEXT_REDIS_KEY_PREFIX=ai-live:room-context

# Automatic reply safety and load control
AI_MAX_REPLY_CHARACTERS=160
AI_USER_COOLDOWN=PT3S
AI_MAX_MODEL_CALLS_PER_WINDOW=60
AI_MODEL_CALL_RATE_WINDOW=PT1M
AI_MAX_PENDING_PER_ROOM=4
AI_MAX_CONCURRENT_PER_ROOM=2
AI_MAX_SCHEDULED_ROOMS=100
AI_MAX_QUEUE_WAIT=PT20S
AI_REPLY_WORKER_THREADS=4
AI_REPLY_POLICY_REDIS_KEY_PREFIX=ai-live:reply-policy

# Optional AI danmaku output. Runtime defaults to OVERLAY_ONLY.
AI_DANMAKU_MAX_CHARACTERS=40
AI_DANMAKU_MINIMUM_INTERVAL=PT10S
AI_DANMAKU_ECHO_RETENTION=PT2M

# Local audit retention and SSE stability
REPLY_HISTORY_RETENTION=P7D
DATA_CLEANUP_INTERVAL=PT1H
SSE_HEARTBEAT_INTERVAL=PT15S
# Typewriter playback for already moderated Overlay replies.
OVERLAY_STREAM_CHARACTER_INTERVAL=PT0.02S
OVERLAY_STREAM_MAX_PENDING_REPLIES=32

# Official Bilibili Open Live. Never commit real values.
BILIBILI_OPEN_LIVE_ENABLED=false
# Automatically connect during backend startup and renew an expired interaction session.
BILIBILI_AUTO_CONNECT=true
BILIBILI_API_BASE_URL=https://live-open.biliapi.com
BILIBILI_ACCESS_KEY_ID=
BILIBILI_ACCESS_KEY_SECRET=
BILIBILI_APP_ID=0
# Broadcaster identity code from https://play-live.bilibili.com/ (not the room ID).
BILIBILI_IDENTITY_CODE=
BILIBILI_REQUEST_TIMEOUT=PT10S
BILIBILI_HEARTBEAT_INTERVAL=PT20S
BILIBILI_RECONNECT_DELAY=PT5S
# Backoff reaches its maximum at this level; reconnecting continues indefinitely.
BILIBILI_MAX_SESSION_RESTART_ATTEMPTS=6
BILIBILI_MAX_HEARTBEAT_FAILURES=3
BILIBILI_EVENT_WORKER_THREADS=4
BILIBILI_MAX_PENDING_EVENTS=100

# Official-event-based audience estimates (not an exact online count)
LIVE_AUDIENCE_ACTIVE_WINDOW=PT5M
LIVE_AUDIENCE_SESSION_TTL=PT12H
LIVE_AUDIENCE_REDIS_KEY_PREFIX=ai-live:audience

# Viewer entry welcome: aggregate arrivals, deduplicate per interaction session, and never interrupt replies.
VIEWER_WELCOME_ENABLED=true
VIEWER_WELCOME_AGGREGATION_WINDOW=PT6S
VIEWER_WELCOME_FLUSH_INTERVAL=PT1S
VIEWER_WELCOME_MAX_DELAY=PT15S
VIEWER_WELCOME_DEDUPLICATION_TTL=PT12H
VIEWER_WELCOME_DISPLAY_DURATION=PT5S
VIEWER_WELCOME_MAX_NAMED_VIEWERS=3
VIEWER_WELCOME_MAX_PENDING_VIEWERS=20
VIEWER_WELCOME_REDIS_KEY_PREFIX=ai-live:viewer-welcome
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# AUTO prefers Responses and falls back only when that endpoint is explicitly unsupported.
OPENAI_API_MODE=AUTO
# Choose a model available from your OpenAI-compatible provider.
OPENAI_MODEL=
AI_TIMEOUT_SECONDS=8

# Optional free, self-hosted internet search for time-sensitive viewer questions.
# docker compose starts SearXNG on localhost:8081; enable it explicitly after Docker starts.
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_ENDPOINT=http://localhost:8081/search
AI_WEB_SEARCH_MAX_RESULTS=3
AI_WEB_SEARCH_TIMEOUT=PT8S
AI_WEB_SEARCH_MAX_QUERY_CHARACTERS=200
AI_WEB_SEARCH_MAX_RESULT_CHARACTERS=3000
